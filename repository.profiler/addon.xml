<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.profiler"
       name="Profiler Repo"
       version="1.0.0"
       provider-name="MDMAinsley">
  <extension point="xbmc.addon.repository"
             name="Profiler Repo">
    <dir>
      <info>https://YOUR_DOMAIN_OR_GITHUB_PAGES/addons.xml</info>
      <checksum>https://YOUR_DOMAIN_OR_GITHUB_PAGES/addons.xml.md5</checksum>
      <datadir zip="true">https://YOUR_DOMAIN_OR_GITHUB_PAGES/zips/</datadir>
    </dir>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary>MDMAinsley's add-on repository</summary>
    <description>All addons created by me.</description>
    <platform>all</platform>
	<assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
  
</addon>
